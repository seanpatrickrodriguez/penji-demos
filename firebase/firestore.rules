rules_version = '2';

// Generated by @penji-demos/security-rules-engine from "Diabetes prevention program", version 1.
// Change the configuration and generate again; this file is not edited by hand.
service cloud.firestore {
  match /databases/{database}/documents {
    // Who is signed in and what covers what (the platform).
    // Who is signed in, and what the server put on their token.
    function isSignedIn() { return request.auth != null; }
    function claim(name) { return request.auth.token.get(name, []); }
    function holdsRole() { return claim('roles').size() > 0; }
    function holdsAny(roleIds) { return claim('roles').hasAny(roleIds); }

    // A scope covers a tenant when it is the tenant or any tenant above it, and a
    // record when it covers the record's tenant, or is the record or any record above it.
    function tenantLine(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)).data.line; }
    function coversTenant(tenantId) { return claim('tenantScopes').hasAny(tenantLine(tenantId)); }
    function coversEntity(tenantId, entity) { return coversTenant(tenantId) || claim('entityScopes').hasAny(entity.line); }

    // Only a record's values change from the browser; its kind, parent and line are the server's.
    function changesOnlyValues() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['values']); }

    // Tenants and their records (the platform).
    match /tenants/{tenantId} {
      allow get: if isSignedIn() && holdsRole() && coversTenant(tenantId);
      allow list, create, update, delete: if false;

      match /entities/{entityId} {
        allow list: if isSignedIn() && holdsRole() && coversTenant(tenantId);
        allow get: if isSignedIn() && holdsRole() && coversEntity(tenantId, resource.data);
        allow update: if isSignedIn() && holdsRole() && coversEntity(tenantId, resource.data)
          && changesOnlyValues()
          && mayEditRecord();
        // Records are added and removed by the server.
        allow create, delete: if false;
      }
    }

    // Who may edit each kind of record (generated from the configuration).
    // Cohort: the editCohort permission, held by dataSpecialist.
    function mayEditCohort() {
      return resource.data.kind == 'cohort' && holdsAny(['dataSpecialist']) && isCohortValues(request.resource.data.values);
    }

    // Participant: the editEnrollment permission, held by dataSpecialist.
    function mayEditParticipant() {
      return resource.data.kind == 'participant' && holdsAny(['dataSpecialist']) && isEnrollmentValues(request.resource.data.values);
    }

    function mayEditRecord() { return mayEditCohort() || mayEditParticipant(); }

    // What each record may hold (generated from the configuration).
    // The cohort form: its own fields only, each its type and within its limits.
    function isCohortValues(v) {
      return v.keys().hasOnly(['cohortCode', 'cohortKind', 'cohortStartDate'])
        && ('cohortCode' in v && v.cohortCode is string && v.cohortCode.size() <= 25)
        && ('cohortKind' in v && v.cohortKind in ['group', 'individual'])
        && ('cohortStartDate' in v && v.cohortStartDate is string && v.cohortStartDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        ;
    }

    // The enrollment form: its own fields only, each its type and within its limits.
    function isEnrollmentValues(v) {
      return v.keys().hasOnly(['participantCode', 'coachCode', 'enrollmentDate', 'ageYears', 'heightInches', 'identifiesAsAsian', 'a1cPercent', 'a1cTestDate', 'a1cReportedDate', 'fastingGlucoseMgDl', 'fastingGlucoseTestDate', 'oralGlucoseToleranceMgDl', 'oralGlucoseToleranceTestDate', 'bloodTestSource', 'gestationalDiabetesHistory', 'riskTestPositive', 'diabetesDiagnosed', 'pregnant', 'medicarePartB', 'endStageRenalDisease', 'priorMdpp'])
        && ('participantCode' in v && v.participantCode is string && v.participantCode.size() <= 25)
        && ('coachCode' in v && v.coachCode is string && v.coachCode.size() <= 25)
        && ('enrollmentDate' in v && v.enrollmentDate is string && v.enrollmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && ('ageYears' in v && v.ageYears is int && v.ageYears >= 0 && v.ageYears <= 125)
        && ('heightInches' in v && v.heightInches is number && v.heightInches >= 30 && v.heightInches <= 98)
        && ('identifiesAsAsian' in v && v.identifiesAsAsian is bool)
        && (!('a1cPercent' in v) || v.a1cPercent == null || v.a1cPercent is number && v.a1cPercent >= 2.5 && v.a1cPercent <= 18)
        && (!('a1cTestDate' in v) || v.a1cTestDate == null || v.a1cTestDate is string && v.a1cTestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('a1cReportedDate' in v) || v.a1cReportedDate == null || v.a1cReportedDate is string && v.a1cReportedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('fastingGlucoseMgDl' in v) || v.fastingGlucoseMgDl == null || v.fastingGlucoseMgDl is number && v.fastingGlucoseMgDl >= 20 && v.fastingGlucoseMgDl <= 600)
        && (!('fastingGlucoseTestDate' in v) || v.fastingGlucoseTestDate == null || v.fastingGlucoseTestDate is string && v.fastingGlucoseTestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('oralGlucoseToleranceMgDl' in v) || v.oralGlucoseToleranceMgDl == null || v.oralGlucoseToleranceMgDl is number && v.oralGlucoseToleranceMgDl >= 20 && v.oralGlucoseToleranceMgDl <= 600)
        && (!('oralGlucoseToleranceTestDate' in v) || v.oralGlucoseToleranceTestDate == null || v.oralGlucoseToleranceTestDate is string && v.oralGlucoseToleranceTestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('bloodTestSource' in v) || v.bloodTestSource == null || v.bloodTestSource in ['lab', 'selfReported'])
        && ('gestationalDiabetesHistory' in v && v.gestationalDiabetesHistory is bool)
        && ('riskTestPositive' in v && v.riskTestPositive is bool)
        && ('diabetesDiagnosed' in v && v.diabetesDiagnosed is bool)
        && ('pregnant' in v && v.pregnant is bool)
        && ('medicarePartB' in v && v.medicarePartB is bool)
        && (!('endStageRenalDisease' in v) || v.endStageRenalDisease == null || v.endStageRenalDisease is bool)
        && (!('priorMdpp' in v) || v.priorMdpp == null || v.priorMdpp is bool)
        ;
    }
  }
}
