{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "apps",
  "projects": {
    "dprp-evaluation": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/dprp-evaluation",
      "sourceRoot": "apps/dprp-evaluation/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/dprp-evaluation/src/main.ts",
            "tsConfig": "apps/dprp-evaluation/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/dprp-evaluation/public"
              }
            ],
            "styles": [
              "@fontsource/public-sans/400.css",
              "@fontsource/public-sans/600.css",
              "@fontsource-variable/source-serif-4/opsz.css",
              "apps/dprp-evaluation/src/styles.scss"
            ],
            "outputPath": "dist/dprp-evaluation"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dprp-evaluation:build:production"
            },
            "development": {
              "buildTarget": "dprp-evaluation:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/dprp-evaluation/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
