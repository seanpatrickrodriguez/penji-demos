{
  "name": "penji-demos",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve dprp-evaluation",
    "build": "ng build dprp-evaluation",
    "build:site": "ng build dprp-evaluation --base-href /demos/dprp-evaluation/",
    "test": "vitest run --config vitest.config.packages.ts",
    "test:packages": "vitest run --config vitest.config.packages.ts",
    "typecheck": "tsc -p tsconfig.packages.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start:fleet": "ng serve fleet-supply",
    "build:fleet": "ng build fleet-supply",
    "build:fleet-site": "ng build fleet-supply --base-href /demos/fleet-supply/",
    "start:totp": "ng serve totp-sign-in",
    "build:totp": "ng build totp-sign-in",
    "build:totp-site": "ng build totp-sign-in --base-href /demos/totp-sign-in/",
    "rules:generate": "tsx scripts/generate-firestore-rules.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-penji-tenants \"vitest run --config vitest.config.rules.ts\"",
    "rules:deploy": "firebase deploy --only firestore:rules --project penji-demos-tenants",
    "seed:tenants": "GOOGLE_CLOUD_QUOTA_PROJECT=penji-demos-tenants tsx scripts/seed-tenant-network.ts",
    "start:tenants": "ng serve tenant-isolation",
    "build:tenants": "ng build tenant-isolation",
    "build:tenants-site": "ng build tenant-isolation --base-href /demos/tenant-isolation/"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "firebase": "^12.19.0",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^13.10.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
